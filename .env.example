# ==========================================================
# Skill Demand Intelligence (E') — Environment Variables
# คัดลอกไฟล์นี้เป็น .env.local (สำหรับ Next.js) และ .env (สำหรับ Python pipeline)
# ห้าม commit ไฟล์ .env หรือ .env.local ขึ้น git เด็ดขาด
# ==========================================================

# --- 1. Supabase (Database & Auth) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# ใช้เฉพาะฝั่ง Server / Python ETL เท่านั้น ห้ามส่งไปฝั่ง Browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres:your-password@db.your-project-id.supabase.co:5432/postgres

# --- 2. ML Champion FastAPI Service (Render Free / เซิร์ฟเวอร์มหาวิทยาลัย) ---
ML_API_URL=http://localhost:8000
ML_API_KEY=change-this-shared-secret-key

# --- 3. Gemini Floating Chat (/api/chat) ---
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# --- 4. One-click Demo Persona Credentials (Server-only) ---
DEMO_STUDENT_DATA_EMAIL=demo.student.data@example.com
DEMO_STUDENT_DATA_PASSWORD=change-me
DEMO_STUDENT_ACC_EMAIL=demo.student.acc@example.com
DEMO_STUDENT_ACC_PASSWORD=change-me
DEMO_INSTITUTION_EMAIL=demo.institution@example.com
DEMO_INSTITUTION_PASSWORD=change-me
DEMO_ADMIN_EMAIL=demo.admin@example.com
DEMO_ADMIN_PASSWORD=change-me

# --- 5. Scraper Polite Config ---
SCRAPER_USER_AGENT="SkillDemandIntelligence-StudentProject/1.0 (+academic-project; contact: your-email@university.ac.th)"
SCRAPER_MIN_DELAY_SEC=5.0
